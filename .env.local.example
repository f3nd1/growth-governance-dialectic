# Copy to .env.local and fill in. NEVER commit .env.local.
# All keys are optional — without them the app runs fully offline
# on the deterministic simulator.

# OpenAI (enables live persona/interview generation)
VITE_OPENAI_KEY=sk-your-key-here

# Supabase (enables cloud sync of workspace state; anon/publishable key ONLY,
# never a service_role key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
